# Copy this file to .env and fill in real values before going live.

# A long, random, secret string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the app listens on. Hostinger's Node.js hosting usually sets this
# for you automatically — only change if you know your host requires it.
PORT=3000
