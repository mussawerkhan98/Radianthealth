# Copy to .env and fill in real values. NEVER commit .env to git.

# --- Database (PostgreSQL) ---------------------------------------------
# Recommended: a free Neon (neon.tech) or Supabase database. The same URL
# works from Hostinger, Vercel and a VPS, so moving hosts = no data move.
# Neon: DATABASE_URL = the "pooled" connection string (host contains -pooler)
#       DIRECT_URL   = the direct (non-pooled) string, used for migrations
# Own Postgres (VPS/local): set both to the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Security ------------------------------------------------------------
# Long random secret for login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Optional: separate key for encrypting the SMTP password stored in the DB
# (defaults to JWT_SECRET). Changing it means re-entering the SMTP password.
# SETTINGS_KEY=

# --- Clinic ----------------------------------------------------------------
# Timezone used for "today" when booking (no booking past slots).
CLINIC_TZ=Asia/Dubai

# --- Optional: email via environment instead of Admin → Settings ---------
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@radianthealthalliance.com
# SMTP_PASS=
# SMTP_FROM="Radiant Health Alliance <noreply@radianthealthalliance.com>"

# Optional: only if the API is called from another domain.
# CORS_ORIGIN=https://radianthealthalliance.com

# Hostinger/VPS set PORT automatically; only change if needed.
PORT=3000
NODE_ENV=production
