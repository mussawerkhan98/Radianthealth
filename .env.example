# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit .env to git.

# --- Database (Turso / libSQL) --------------------------------------------
# Turso dashboard → your database → "Connect": copy the URL (libsql://...)
# and create a token. For offline local dev you can use: file:./local.db
TURSO_DATABASE_URL=libsql://radiant-health-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# --- Security ------------------------------------------------------------
# Long random secret for login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: separate key for encrypting the SMTP password stored in the DB
# (defaults to JWT_SECRET). Changing it means re-entering the SMTP password.
# SETTINGS_KEY=

# --- Clinic ----------------------------------------------------------------
# Timezone used for "today" when booking (no booking past slots).
CLINIC_TZ=Asia/Dubai

# --- Brevo (appointment auto-reply + clinic notification) ---------------
# Brevo → SMTP & API → API keys. Set in Vercel for Production, Preview, Development.
BREVO_API_KEY=

# --- Optional: email via environment instead of Admin → Settings ---------
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@radianthealthalliance.com
# SMTP_PASS=
# SMTP_FROM="Radiant Health Alliance <noreply@radianthealthalliance.com>"

# --- Video appointments ---------------------------------------------------
# Works out of the box with free Jitsi Meet (meet.jit.si) — nothing to set.
# VIDEO_ENABLED=false          # hide the "Video call" option entirely
# JITSI_DOMAIN=meet.jit.si     # or your own Jitsi server later
# Optional upgrade: Daily.co private rooms (Daily dashboard → Developers → API key)
# DAILY_API_KEY=

# Optional: only if the API is called from another domain.
# CORS_ORIGIN=https://radianthealthalliance.com
