// Radiant Health Alliance — database schema (Turso / libSQL = SQLite, via Prisma).
//
// The app connects to Turso through the libSQL driver adapter (src/db.js).
// Schema changes: edit this file, then run `npm run db:new-migration -- <name>`
// and `npm run db:migrate` (see README).
//
// IDs are strings so records migrated from the old data/db.json keep their
// original ids (e.g. "dept_yau0aaot"). New records get prefixed random ids.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // "native" = your machine / VPS, "rhel-openssl-3.0.x" = Vercel.
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  // Only used by Prisma tooling (e.g. `prisma migrate diff`). At runtime the
  // app uses TURSO_DATABASE_URL + TURSO_AUTH_TOKEN via the libSQL adapter.
  url      = "file:./dev.db"
}

model Department {
  id            String   @id
  name          String
  description   String   @default("")
  icon          String   @default("stethoscope")
  sortOrder     Int      @default(0)
  active        Boolean  @default(true) // "deleted" departments are hidden, not removed
  // Public department page (department.html) — edited in Admin → Departments → Edit page
  tagline       String   @default("")
  about         String   @default("")
  services      String   @default("") // one per line
  conditions    String   @default("") // one per line
  hours         String   @default("") // free text, one line per day range
  faqs          String   @default("[]") // JSON: [{ "q": "...", "a": "..." }]
  bannerData    Bytes?
  bannerMime    String   @default("")
  bannerVersion Int      @default(0)
  createdAt     DateTime @default(now())
  doctors       Doctor[]
}

model Doctor {
  id                 String          @id
  name               String
  departmentId       String
  department         Department      @relation(fields: [departmentId], references: [id])
  specialty          String          @default("")
  bio                String          @default("")
  photo              String? // base64 data URL (kept for compatibility with the current frontend)
  email              String          @unique
  passwordHash       String
  mustChangePassword Boolean         @default(true)
  workStart          String          @default("09:00")
  workEnd            String          @default("17:00")
  slotMinutes        Int             @default(30)
  workingDays        String          @default("1,2,3,4,5") // comma-separated, 0 = Sunday
  active             Boolean         @default(true) // "deleted" doctors are deactivated so history is kept
  offersVideo        Boolean         @default(false) // can be booked for video appointments
  // Public profile (Admin → profile editor; shown on profile.html)
  about              String          @default("") // longer "about me"
  qualifications     String          @default("") // one per line, e.g. "MBBS — University of X (2010)"
  education          String          @default("") // training / fellowships, one per line
  expertise          String          @default("") // comma-separated areas of focus
  languages          String          @default("") // comma-separated
  experienceYears    Int             @default(0)
  createdAt          DateTime        @default(now())
  appointments       Appointment[]
  records            MedicalRecord[]

  @@index([departmentId])
}

model Staff {
  id                 String   @id
  role               String   @default("staff") // Role.id (e.g. "admin", "reception"); always set explicitly
  name               String
  email              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Patient {
  id              String          @id
  name            String
  email           String          @unique
  phone           String          @default("")
  // Patient ID: the phone number in one standard form (digits incl. country
  // code, e.g. 971501234567). Unique, so one phone = one patient.
  phoneKey        String?         @unique
  dob             String          @default("")
  gender          String          @default("")
  passwordHash    String
  isGuest         Boolean         @default(false) // booked without creating an account
  // Promotion emails: sent to everyone with a real email unless they unsubscribe.
  marketingOptOut Boolean         @default(false)
  marketingKey    String          @default("") // secret for the unsubscribe link (made on first send)
  country         String          @default("") // for marketing groups; blank = guessed from phone
  region          String          @default("") // e.g. emirate / city
  createdAt       DateTime        @default(now())
  appointments    Appointment[]
  records         MedicalRecord[]
}

model Appointment {
  id              String   @id
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  date            String // YYYY-MM-DD (clinic local date)
  time            String // HH:MM
  reason          String   @default("")
  status          String   @default("confirmed") // "confirmed" | "cancelled"
  visitType       String   @default("in_person") // "in_person" | "video"
  // Video visits: secret keys in the patient's and doctor's join links, and
  // the Daily.co room (created the first time someone joins).
  videoPatientKey String   @default("")
  videoDoctorKey  String   @default("")
  videoRoom       String   @default("")
  videoRoomUrl    String   @default("")
  createdAt       DateTime @default(now())

  // A partial unique index (one active booking per doctor/date/time) is
  // added in the SQL migration — Prisma can't express partial indexes.
  @@index([doctorId, date])
  @@index([patientId])
}

model MedicalRecord {
  id            String       @id
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  date          String // YYYY-MM-DD
  diagnosis     String       @default("")
  notes         String
  prescription  String       @default("")
  // Who typed it in, when that isn't the doctor (e.g. admin entering a report).
  enteredById   String       @default("")
  enteredByName String       @default("")
  createdAt     DateTime     @default(now())
  files         RecordFile[]

  @@index([patientId])
}

// Files a doctor attaches to a medical record (lab reports, scans, PDFs…).
// Stored privately in the database; only downloadable through the API by
// the patient's doctors and admins.
model RecordFile {
  id           String        @id
  recordId     String
  record       MedicalRecord @relation(fields: [recordId], references: [id])
  patientId    String
  uploadedById String // doctor id
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime      @default(now())

  @@index([recordId])
  @@index([patientId])
}

model ContactMessage {
  id        String   @id
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model TeamMember {
  id              String   @id
  name            String
  role            String
  bio             String   @default("")
  photo           String?
  sortOrder       Int      @default(0)
  // Public profile (Admin → profile editor; shown on profile.html)
  about           String   @default("") // longer "about me"
  qualifications  String   @default("") // one per line, e.g. "MBBS — University of X (2010)"
  education       String   @default("") // training / fellowships, one per line
  expertise       String   @default("") // comma-separated areas of focus
  languages       String   @default("") // comma-separated
  experienceYears Int      @default(0)
  createdAt       DateTime @default(now())
}

// Key/value site settings (contact info, notification emails, SMTP).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Staff roles and what they may do (admin-editable). "admin" always has
// every permission and can't be edited.
model Role {
  id          String   @id
  name        String
  permissions String   @default("") // comma-separated permission keys
  builtIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Promotion emails (Admin → Marketing). Sent to every patient with a real
// email who hasn't unsubscribed. The image is public (emails load it).
model Campaign {
  id          String    @id
  subject     String
  headline    String    @default("")
  body        String    @default("")
  buttonText  String    @default("")
  buttonUrl   String    @default("")
  imageData   Bytes?
  imageMime   String    @default("")
  status      String    @default("draft") // draft | sending | sent
  sentAt      DateTime?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdById String    @default("")
  audience    String    @default("{}") // JSON: who it goes to (source, countries, regions, groups)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// People on the marketing list who aren't (necessarily) patients — added by
// hand or imported from a CSV. Same email as a patient = same person.
model MarketingContact {
  id        String   @id
  email     String   @unique
  name      String   @default("")
  phone     String   @default("")
  country   String   @default("")
  region    String   @default("")
  groups    String   @default("") // comma-separated, e.g. "VIP,Corporate"
  optOut    Boolean  @default(false)
  unsubKey  String   @default("")
  source    String   @default("manual") // manual | import
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Certificates / licences shown on a doctor's or team member's public profile.
// Public files (anyone viewing the profile can open them).
model ProfileCertificate {
  id        String   @id
  ownerType String // "doctor" | "team"
  ownerId   String
  title     String
  issuer    String   @default("")
  year      String   @default("")
  filename  String   @default("")
  mimeType  String   @default("")
  size      Int      @default(0)
  data      Bytes?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
}
